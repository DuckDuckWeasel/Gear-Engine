{
  "hosting": {
    "public": "../GearEngineWebGL",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/*.py",
      "**/*.command",
      "**/*.bat",
      "**/*.sh",
      "ReadMe.txt"
    ],
    "headers": [
      {
        "source": "**/*.unityweb",
        "headers": [
          {
            "key": "Content-Encoding",
            "value": "br"
          },
          {
            "key": "Cache-Control",
            "value": "public,max-age=31536000,immutable"
          }
        ]
      },
      {
        "source": "**/*.wasm.unityweb",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/wasm"
          }
        ]
      },
      {
        "source": "**/*.js.unityweb",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/javascript"
          }
        ]
      },
      {
        "source": "**/*.data.unityweb",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/octet-stream"
          }
        ]
      }
    ]
  }
}
